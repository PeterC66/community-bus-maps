  "_comment": [
    "What check-doc-acronyms.mjs (claude-skills tools/) reads in THIS repository. Decided by Peter on 2026-09-21 (buses-data status review): the live documents are checked; dated history is not, because it must not be rewritten to gloss a term. A key ending in / excludes a whole folder.",
    "The three notAbbreviations groups are copied, reasons and all, from buses-data .doc-acronyms.json, so the three repositories make the same judgement about the same words."
  ],
  "definitions": [
    "docs/SHORT-FORMS.md"
  ],
  "defined": {},
  "excluded": {
    "CHANGELOG.d/": "one dated fragment per change, assembled into CHANGELOG.md; history, never rewritten to gloss a term",
    "docs/_archive/": "archived plans and runbooks, a record rather than a live document (the same reason stamp-policy.json gives for leaving _archive unstamped)"
  },
