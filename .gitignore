# ---- Secrets & config (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Runtime data & object store (map data / customer PII stay OUT of git) ----
/data/

# Backup output. `npm run backup` writes to <DATA_DIR>/../backups/<timestamp>/,
# which is INSIDE the repo - and it contains map data and a copy of the SQLite
# database. /data/ being ignored is not enough; this must be ignored too.
/backups/
*.sqlite
*.sqlite-*
*.db

# ---- Map fixtures pulled from the (separate) Buses repo for local tests ----
/fixtures/
/engine-maps/

# ---- Node ----
node_modules/
npm-debug.log*
.npm/

# ---- Build / scratch ----
/tmp/
/scratch/
*.log
.DS_Store
Thumbs.db

# ---- Editor ----
.vscode/
.idea/

# ---- Impeccable (design-review skill): machine-local state, not shared config ----
.impeccable/config.local.json
.impeccable/live/

# ---- Generated documents ----
# CHANGELOG.md is built from CHANGELOG.head.md + CHANGELOG.d/ by
#   npm run changelog
# and is NOT in git (2026-09-03). It was, and every commit regenerated it: 60
# of the last 60 commits touched it, so two concurrent sessions conflicted on
# one line of index every time. A derived file in git is a conflict waiting for
# the next pair of sessions. The changelog itself is CHANGELOG.d/.
CHANGELOG.md

# git worktrees live here and are whole checkouts of this repository. Untracked
# and unignored, one `git add -A` would commit two copies of the repo into
# itself; and until 2026-09-03 they also broke prove-red-portal-lib, which
# copied the tree and choked on a nested node_modules symlink.
.claude/worktrees/
