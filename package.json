{
  "name": "community-bus-maps",
  "version": "0.8.0-P7",
  "private": true,
  "description": "Self-serve portal for community bus maps — public shopfront plus a deterministic map renderer. Apache-2.0.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Peter Cooper",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node scripts/test-p6.mjs && node scripts/test-p7.mjs",
    "test:p6": "node scripts/test-p6.mjs",
    "verify": "npm run verify:area && npm run verify:place",
    "verify:area": "node --env-file-if-exists=.env scripts/verify-reproduce.mjs",
    "verify:place": "node --env-file-if-exists=.env scripts/verify-reproduce-place.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "prune:staged": "node --env-file-if-exists=.env scripts/prune-staged.mjs",
    "test:p7": "node scripts/test-p7.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "sharp": "^0.34.5"
  }
}
