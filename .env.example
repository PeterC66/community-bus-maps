# Copy to .env and adjust. NEVER commit .env.
# ---- Server ----
PORT=5180
HOST=127.0.0.1
NODE_ENV=development

# ---- PILOT: pilot mode (see docs/PILOT.md) ----
# While the system has no real customers, every page carries a "Pilot" banner and
# every rendered sheet carries a pilot stamp.
# ON unless explicitly set to 0 — the honest state is the default.
# Set PILOT_MODE=0 to switch the whole thing off when the pilot ends.
# NOTE: this no longer controls robots.txt — see ALLOW_INDEXING below.
PILOT_MODE=1

# ---- Search-engine indexing ----
# OFF unless explicitly set to 1: robots.txt serves `Disallow: /` and the site
# cannot be found in a search engine. Set ALLOW_INDEXING=1 to become discoverable.
#
# Split from PILOT_MODE on 2026-08-21. They are two different claims: the pilot
# banner says "this is a pilot", which stays true and honest for as long as it is;
# `Disallow: /` says "nobody may find this at all". Tying them together meant the
# only way to become discoverable was to stop admitting it was a pilot.
#
# Everything a crawler needs is already in place (sitemap.xml, per-map titles,
# descriptions, canonicals, Open Graph and JSON-LD, and the /m/<slug>/services text
# pages) — this flag is the only thing in front of it.
ALLOW_INDEXING=0

# ---- Public front (P6) ----
# Absolute base URL of the public site, used in robots.txt + sitemap.xml when the
# app runs behind a proxy/CDN. Leave blank to use the request's own host.
PUBLIC_BASE_URL=

# ---- Storage (kept outside git) ----
DATA_DIR=./data
DB_PATH=./data/portal.sqlite

# ---- Byte-identical reproduce test ----
# YOU PROBABLY DO NOT NEED TO SET EITHER OF THESE ANY MORE. Since 2026-08-20 the
# gates find a COMMITTED fixture by themselves: Areas/_portal-fixture/<Town> and
# Places/_portal-fixture/<Place> in the buses-data repo. Set BUSES_DIR (below)
# and `npm run verify` runs for real with no further configuration — that is the
# whole of technical-audit_2026-08-19 V2, which called this the one thing to fix
# if only one thing gets fixed.
#
# AND IT NO LONGER SKIPS. With no fixture anywhere, the gates FAIL. They used to
# print "skipping" and exit 0, so a fresh clone, a CI run and a second developer
# all got a green result from a check that had not executed. `npm run verify --
# --allow-skip` is the escape hatch for a clone of the portal alone, and it says
# out loud that it proved nothing.
#
# Set the two variables below only to point a gate at something OTHER than the
# committed fixture — normally the live render tree, where a real regression
# shows up first. An entry that does not exist is ignored, so a stale path here
# silently falls back to the committed fixture rather than failing.
#
# AN ENTRY THAT DOES EXIST AND IS OLD IS THE OTHER TRAP, and it is the one that
# bit: these paths carry a version number, so they go stale at every rollout.
# This laptop gated St Ives v6.55 for six days after the committed fixture was
# refreshed from v6.59 — same `npm run verify`, two machines, two packs, no
# message (OA-180). The resolver now compares both packs' build-meta.json and
# prints a "BEHIND the committed fixture" warning when the entry below is the
# older one. It is a warning, not a failure: aiming at the live tree is the
# stronger gate when the path is current. Repoint it when you see it.
#
# Absolute path to ONE staged town render dir from the separate Buses repo,
# e.g. a ".../Buses/Areas/St Ives/S5-render/v6.6_2026-07-10_1525" folder that contains
# gen_internal.js + its data + the shipped internal.svg / internal.jpg.
# The test is skipped if this is unset or missing.
#
# MAY BE A `;`-SEPARATED LIST of town render folders (`;`, not `:`, because these are
# Windows absolute paths). verify:area takes the first that exists — determinism is
# proved as well by one town as by three. verify:defaults uses ALL of them, and needs
# to: no single town exercises every escape hatch, so a one-town list makes at least
# one key report as dead code. Measured 2026-08-18 — `legendPlace` bites only on
# Huntingdon, `badgeFit` on five towns but not Huntingdon, `hubFit` on seven but not
# March. Three towns covering all thirteen keys, e.g.:
#   FIXTURE_DIR=.../St Ives/S5-render/vN;.../Huntingdon/S5-render/vN;.../Beaconsfield/S5-render/vN
FIXTURE_DIR=

# Absolute path to ONE place fixture dir (the *.json payload + optional
# base-overrides.json + the skill-rendered reference internal/external SVG+JPG),
# e.g. ".../Buses/Places/_portal-fixture/High Wycombe Aldi". Proves the
# VENDORED place engine (engine/place/) reproduces a skill-rendered place leaflet.
# Skipped if unset or missing.
PLACE_FIXTURE_DIR=

# ---- Ops (P7) ----
# Set to expose Prometheus metrics at /metrics (?token=… or a Bearer header).
# Unset and the endpoint 404s — an admin session can still read it in a browser.
METRICS_TOKEN=

# ---- Status push (fool-proofing plan item 3) ----
# Set to accept POST /api/admin/status — the laptop's push-status.mjs sends
# status.js's byte-identical gate + engine/S6 staleness here so it shows in the
# same worklist as the portal's own queues. Same shape as METRICS_TOKEN: a
# Bearer header or ?token=, unset ⇒ 404 (an admin session also works).
STATUS_TOKEN=

# ---- Email (magic-link auth) ----
# Leave blank in dev: sign-in links are printed to the SERVER CONSOLE, not emailed.
# EMAIL_PROVIDER=resend is the only provider wired up (src/email/resend.js) —
# needs RESEND_API_KEY, and SPF/DKIM records at 20i for EMAIL_FROM's domain so
# mail doesn't land in a council's spam folder (GO-LIVE.md §2.3, §3).
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# ---- Separation of duties (technical-audit_2026-08-19 S6) ----
# The editor who submits a version cannot approve it. README.md and
# src/publish/index.js have claimed that since P4; the code only started
# enforcing it on 2026-08-20, and every one of the 41 publications before that
# date was a self-approval on a deployment with two users.
#
# Set to 1 to allow a self-approval anyway. It is not a way of switching the rule
# off quietly: a publication made under it is stamped `selfApproved: true` in the
# decision evidence, the audit row and the API response, so it is legible
# afterwards rather than only remembered.
#
# UNSET IT AS SOON AS A SECOND PERSON HOLDS `approver`. Until then, leaving it
# unset would simply stop anyone publishing anything, which is worse than a
# recorded self-approval.
ALLOW_SELF_APPROVAL=1

# ---- Delivery (laptop -> host, GO-LIVE.md §2.1) ----
# scripts/deliver-map.mjs — rsync a built map up, verify it, import it inside a
# throwaway container, restart the service. Run as `npm run deliver -- --src …`
# so these come from THIS FILE, not shell env-var assignment — on Windows Git
# Bash, `DEPLOY_APP_DIR=/opt/... node …` gets silently path-mangled by MSYS
# (it turns the leading `/` into a Windows path); reading .env sidesteps that.
# Pass --map <slug> instead of --name/--slug/--subject to refresh an EXISTING
# map (runs propose-update.mjs) instead of importing a new one.
DEPLOY_HOST=
DEPLOY_SSH_KEY=
DEPLOY_APP_DIR=

# ---- Buses data repo, demo seed, and the post-deploy sign-in smoke test ----
# BUSES_DIR is where the separate buses-data repo is checked out. It is what
# lets `npm run verify` find the committed fixtures with nothing else set (see
# the reproduce-test block above); scripts/seed-demo.mjs uses it too. If this
# repo and buses-data are cloned side by side, it can be left blank — the gates
# also look at ../buses-data and ../Buses.
# ADMIN_EMAIL is also the address `npm run smoke:signin` sends its one real
# magic link to after a deploy (scripts/smoke-signin.mjs) — it must be a
# REGISTERED, ACTIVE user or no send is attempted and the check cannot pass.
BUSES_DIR=
ADMIN_EMAIL=peter@pcooper.me.uk
